lt;/span&gt;{&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;...&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 136, 0); font-style: italic;&quot;&gt;// Hostname verification&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;ext_d2i&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;=&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;X509_get_ext_d2i(peer_certificate,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 133, 83); font-weight: bold;&quot;&gt;85&lt;/span&gt;,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 133, 83); font-weight: bold;&quot;&gt;0&lt;/span&gt;,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 133, 83); font-weight: bold;&quot;&gt;0&lt;/span&gt;);&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;(&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;ext_d2i&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;)&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;{&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;int&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;n&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;=&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;sk_GENERAL_NAME_num(san);&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;for&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;(&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;int&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;i&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;=&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 133, 83); font-weight: bold;&quot;&gt;0&lt;/span&gt;;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;i&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&amp;lt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;n;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;i++)&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;{&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;GENERAL_NAME&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;*g&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;=&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;sk_GENERAL_NAME_value(san,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;i);&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;(g&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&amp;amp;&amp;amp;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;g-&amp;gt;type&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;==&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;GEN_DNS)&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;{&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;const&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;unsigned&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;char&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;*p&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;=&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;ASN1_STRING_get0_data(g-&amp;gt;d.dNSName);&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;int&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;l&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;=&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;ASN1_STRING_length(g-&amp;gt;d.dNSName);&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;(l&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;!=&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;(&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;int&lt;/span&gt;)strlen((&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;const&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;char&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;*)p))&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;{&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 136, 0); font-style: italic;&quot;&gt;// NUL-byte guard&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;GENERAL_NAMES_free(san);&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;X509_free(cert);&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;free(idna);&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;return&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;fail(err,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(128, 0, 128);&quot;&gt;&quot;SAN contains NUL&quot;&lt;/span&gt;);&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;}&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;(hostname_match(hn,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;(&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;const&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;char&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;*)p))&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;{&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;matched&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;=&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 133, 83); font-weight: bold;&quot;&gt;1&lt;/span&gt;;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;break&lt;/span&gt;;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;}&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;}&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;}&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;GENERAL_NAMES_free(san);&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;}&lt;br&gt;}&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 136, 0); font-style: italic;&quot;&gt;// Part of san_or_cn_matches(): iterate dNSName SANs; fall back to CN; NUL guard elided&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;int&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;font-weight: bold; font-style: italic&quot;&gt;hostname_match&lt;/span&gt;(&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;char&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;*hostname,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;char&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;*certname)&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;{&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 136, 0); font-style: italic;&quot;&gt;// Wildcard matches exactly one label: &lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 136, 0); font-style: italic;&quot;&gt;// &quot;*.example.com&quot; -&amp;gt; &quot;foo.example.com&quot;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;(strncmp(certname,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(128, 0, 128);&quot;&gt;&quot;*.&quot;&lt;/span&gt;,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 133, 83); font-weight: bold;&quot;&gt;2&lt;/span&gt;)&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;==&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 133, 83); font-weight: bold;&quot;&gt;0&lt;/span&gt;)&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;{&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;const&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;char&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;*dot&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;=&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;strchr(hostname,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(128, 0, 128);&quot;&gt;&#39;.&#39;&lt;/span&gt;);&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;(!dot)&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;return&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 133, 83); font-weight: bold;&quot;&gt;0&lt;/span&gt;;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;return&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;strcasecmp(certname&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;+&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 133, 83); font-weight: bold;&quot;&gt;2&lt;/span&gt;,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;dot&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;+&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 133, 83); font-weight: bold;&quot;&gt;1&lt;/span&gt;)&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;==&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 133, 83); font-weight: bold;&quot;&gt;0&lt;/span&gt;;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;}&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;return&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;strcasecmp(certname,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;hostname)&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;==&lt;span style=&quot;color: rgb(187, 18