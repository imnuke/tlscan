;&quot;&gt;25&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: inherit; background-color: transparent; padding-left: 5px; padding-right: 5px;&quot;&gt;26&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: inherit; background-color: transparent; padding-left: 5px; padding-right: 5px;&quot;&gt;27&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: inherit; background-color: transparent; padding-left: 5px; padding-right: 5px;&quot;&gt;28&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: inherit; background-color: transparent; padding-left: 5px; padding-right: 5px;&quot;&gt;29&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: inherit; background-color: transparent; padding-left: 5px; padding-right: 5px;&quot;&gt;30&lt;/span&gt;&lt;/font&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;code&quot;&gt;&lt;div&gt;&lt;pre style=&quot;line-height: 125%;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;span&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;int&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;font-weight: bold; font-style: italic&quot;&gt;sub_40675F&lt;/span&gt;(&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;int&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;a1,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;int&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;a2,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;char&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;*a3,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;char&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;*a4)&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;{&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;conffile&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;=&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(128, 0, 128);&quot;&gt;&quot;/.../msmtprc&quot;&lt;/span&gt;;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;for&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;(line&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;=&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 133, 83); font-weight: bold;&quot;&gt;1&lt;/span&gt;;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;line++)&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;{&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;fgets(linebuf,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;sizeof&lt;/span&gt;(linebuf),&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;a3);&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;}&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 136, 0); font-style: italic;&quot;&gt;// ...&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 136, 0); font-style: italic;&quot;&gt;// Load option from configuration file.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;else&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;(strcmp(s1,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(128, 0, 128);&quot;&gt;&quot;tls_certcheck&quot;&lt;/span&gt;)&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;==&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 133, 83); font-weight: bold;&quot;&gt;0&lt;/span&gt;)&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;{&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;(is_on(arg))&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;{&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;mtls-&amp;gt;nocertcheck&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;=&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 133, 83); font-weight: bold;&quot;&gt;0&lt;/span&gt;;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;}&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;else&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;(is_off(arg))&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;{&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;mtls-&amp;gt;nocertcheck&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;=&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 133, 83); font-weight: bold;&quot;&gt;1&lt;/span&gt;;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;}&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;}&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 136, 0); font-style: italic;&quot;&gt;// ...&lt;/span&gt;&lt;br&gt;}&lt;br&gt;mtls_start()&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;{&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;...&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 136, 0); font-style: italic;&quot;&gt;// Certificate checking is conditional.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;(&lt;b&gt;!mtls-&amp;gt;no_certcheck&lt;/b&gt;)&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;{&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 136, 0); font-style: italic;&quot;&gt;// Custom certificate checking algorithm.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;((error_code&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;=&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;b&gt;mtls_check_cert&lt;/b&gt;(mtls,&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;errstr))&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;==&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;TLS_EOK)&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;{&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;SSL_free(...);&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 136, 0); font-style: italic;&quot;&gt;// &amp;lt;- TLS connection terminated.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;SSL_CTX_free(...);&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;return&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;error_code;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;}&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;}&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(44, 44, 255);&quot;&gt;return&lt;/span&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;TLS_EOK;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 136, 0); font-style: italic;&quot;&gt;// &amp;lt;- TLS connection successfully established.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(187, 187, 187);&quot;&gt;&amp;nbsp; &lt;/span&gt;...&lt;br&gt;}&lt;br&gt;&lt;/font&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="546" width="580" x="20" y="14" as="geometry" />
        </mxCell>
