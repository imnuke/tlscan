        <mxCell id="53" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" value="&lt;b&gt;Security Requirements&lt;/b&gt;&lt;br&gt;&lt;br&gt;Proper shutdown with&lt;br&gt;close_notify alert" vertex="1">
          <mxGeometry height="70" width="180" x="1230" y="170" as="geometry" />
