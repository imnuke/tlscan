        <mxCell id="61" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" value="Vulnerability Root Causes and Detection Strategy" vertex="1">
          <mxGeometry height="25" width="1320" x="100" y="435" as="geometry" />
        </mxCell>
        <mxCell id="62" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" value="&lt;b&gt;API Misuse&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Wrong flags/parameters&lt;br&gt;- Missing required calls&lt;br&gt;- Incorrect call order&lt;br&gt;- Callback always succeeds&lt;br&gt;&lt;br&gt;&lt;b&gt;Detection&lt;/b&gt;: Pattern matching&lt;br&gt;on API call sequences" vertex="1">
          <mxGeometry height="140" width="200" x="120" y="465" as="geometry" />
        </mxCell>
        <mxCell id="63" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" value="&lt;b&gt;Insecure Defaults&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Legacy protocol versions&lt;br&gt;- Weak cipher suites&lt;br&gt;- Verification disabled&lt;br&gt;- No hostname check (old APIs)&lt;br&gt;&lt;br&gt;&lt;b&gt;Detection&lt;/b&gt;: Check for missing&lt;br&gt;explicit secure configuration" vertex="1">
          <mxGeometry height="140" width="200" x="340" y="465" as="geometry" />
        </mxCell>
        <mxCell id="64" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" value="&lt;b&gt;Conditional Configuration&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Runtime flags/options&lt;br&gt;- Config file values&lt;br&gt;- Environment variables&lt;br&gt;- CLI arguments&lt;br&gt;&lt;br&gt;&lt;b&gt;Detection&lt;/b&gt;: Cross-boundary&lt;br&gt;dataflow tracing" vertex="1">
          <mxGeometry height="140" width="200" x="560" y="465" as="geometry" />
        </mxCell>
        <mxCell id="65" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" value="&lt;b&gt;Developer Errors&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Copy-paste from examples&lt;br&gt;- Debugging code left in&lt;br&gt;- Compatibility workarounds&lt;br&gt;- Misunderstanding of APIs&lt;br&gt;&lt;br&gt;&lt;b&gt;Detection&lt;/b&gt;: Semantic analysis&lt;br&gt;with LLM understanding" vertex="1">
          <mxGeometry height="140" width="200" x="780" y="465" as="geometry" />
        </mxCell>
        <mxCell id="66" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" value="&lt;b&gt;Our Approach&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;RFC-Grounded Rules&lt;/b&gt;&lt;br&gt;   Define WHAT must be checked&lt;br&gt;&lt;br&gt;2. &lt;b&gt;Semantic API Mapping&lt;/b&gt;&lt;br&gt;   HOW to check in each library&lt;br&gt;&lt;br&gt;3. &lt;b&gt;Three-State Analysis&lt;/b&gt;&lt;br&gt;   PASS / FAIL / CONDITIONAL" vertex="1">
          <mxGeometry height="140" width="200" x="1000" y="465" as="geometry" />
        </mxCell>
