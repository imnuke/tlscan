        </mxCell>
        <mxCell id="30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="280" width="280" x="660" y="120" as="geometry" />
        </mxCell>
        <mxCell id="31" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1" value="Phase 3: Server Authentication" vertex="1">
          <mxGeometry height="25" width="280" x="660" y="125" as="geometry" />
        </mxCell>
        <mxCell id="32" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#666666;" value="Certificate Exchange and Verification" vertex="1">
          <mxGeometry height="15" width="280" x="660" y="148" as="geometry" />
        </mxCell>
        <mxCell id="33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" value="&lt;b&gt;Security Requirements (MUST)&lt;/b&gt;&lt;br&gt;M3: Verify certificate chain to trusted CA&lt;br&gt;M4: Verify server identity (hostname)&lt;br&gt;&lt;br&gt;&lt;b&gt;Best Practice (SHOULD)&lt;/b&gt;&lt;br&gt;S1: Check revocation (CRL/OCSP)&lt;br&gt;S2: Verify crypto strength (SHA-256+)" vertex="1">
          <mxGeometry height="110" width="260" x="670" y="170" as="geometry" />
        </mxCell>
        <mxCell id="34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" value="&lt;b&gt;Violations&lt;/b&gt;&lt;br&gt;- SSL_VERIFY_NONE or VERIFYPEER=0&lt;br&gt;- Missing X509_check_host()&lt;br&gt;- Callback always returns 1&lt;br&gt;- Accepting expired/self-signed certs" vertex="1">
          <mxGeometry height="75" width="260" x="670" y="290" as="geometry" />
        </mxCell>
        <mxCell id="35" edge="1" parent="1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#0066CC;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="940" y="260" as="sourcePoint" />
            <mxPoint x="980" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="280" width="200" x="980" y="120" as="geometry" />
