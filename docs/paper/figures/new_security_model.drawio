        <mxCell id="82" parent="1" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=0;strokeWidth=2;strokeColor=#b85450;size=0.5;fontSize=10;fontColor=#b85450;fontStyle=1" value="Critical Phases" vertex="1">
