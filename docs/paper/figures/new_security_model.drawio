        <mxCell id="86" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1" value="Meta-Rule Reference" vertex="1">
          <mxGeometry height="20" width="180" x="100" y="685" as="geometry" />
        </mxCell>
        <mxCell id="87" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=8;" value="M1: TLS Usage (RFC 9325) - Phase 1&lt;br&gt;M2: Protocol Version (RFC 8996) - Phase 1,2&lt;br&gt;M3: Cert Chain (RFC 5280) - Phase 3&lt;br&gt;M4: Identity (RFC 9525) - Phase 3&lt;br&gt;M5: Cipher Suite (RFC 9325) - Phase 1,2&lt;br&gt;S1: Revocation (RFC 5280) - Phase 3&lt;br&gt;S2: Crypto Strength (RFC 9325) - Phase 3" vertex="1">
          <mxGeometry height="100" width="170" x="105" y="708" as="geometry" />
        </mxCell>
