        <mxCell id="41" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1" value="Phase 4: Secure Channel" vertex="1">
          <mxGeometry height="25" width="200" x="980" y="125" as="geometry" />
        </mxCell>
        <mxCell id="42" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#666666;" value="Encrypted Data Exchange" vertex="1">
          <mxGeometry height="15" width="200" x="980" y="148" as="geometry" />
        </mxCell>
        <mxCell id="43" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" value="&lt;b&gt;Security State&lt;/b&gt;&lt;br&gt;&lt;br&gt;If Phases 1-3 secure:&lt;br&gt;  Confidentiality&lt;br&gt;  Integrity&lt;br&gt;  Authenticity&lt;br&gt;&lt;br&gt;(No additional checks needed)" vertex="1">
          <mxGeometry height="120" width="180" x="990" y="170" as="geometry" />
        </mxCell>
        <mxCell id="44" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" value="&lt;b&gt;Key Insight&lt;/b&gt;&lt;br&gt;All vulnerabilities stem from&lt;br&gt;configuration (Phase 1) or&lt;br&gt;authentication (Phase 3)" vertex="1">
