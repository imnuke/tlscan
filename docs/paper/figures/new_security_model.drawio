        <mxCell id="11" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1" value="Phase 1: Configuration" vertex="1">
          <mxGeometry height="25" width="240" x="100" y="125" as="geometry" />
