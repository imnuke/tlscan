                <mxCell id="upsc-code" value="&lt;pre style=&quot;margin:0;padding:8px;font-family:Consolas,Monaco,monospace;font-size:10px;line-height:1.4;text-align:left;&quot;&gt;tls_connect(..., &lt;b style=&quot;color:#cc0000&quot;&gt;0x01&lt;/b&gt;);&#xa;&lt;span style=&quot;color:#888888&quot;&gt;// bit 4 = 0&lt;/span&gt;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="50" y="270" width="200" height="50" as="geometry"/>
