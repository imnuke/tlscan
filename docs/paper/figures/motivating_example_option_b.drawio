                    <mxGeometry x="290" y="240" width="250" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="upsmon-title" value="/usr/bin/client_b" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="300" y="245" width="130" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="upsmon-code" value="&lt;pre style=&quot;margin:0;padding:8px;font-family:Consolas,Monaco,monospace;font-size:10px;line-height:1.4;text-align:left;&quot;&gt;flags = 0x01;&#xa;&lt;span style=&quot;color:#0000aa&quot;&gt;if&lt;/span&gt; (&lt;b&gt;g_certverify&lt;/b&gt;) flags |= 0x10;&#xa;tls_connect(..., flags);&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="300" y="270" width="230" height="55" as="geometry"/>
