                <mxCell id="lib-title" value="libtls.so (example 1)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="50" y="60" width="120" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="lib-code" value="&lt;pre style=&quot;margin:0;padding:8px;font-family:Consolas,Monaco,monospace;font-size:10px;line-height:1.4;text-align:left;&quot;&gt;&lt;span style=&quot;color:#0000aa&quot;&gt;int&lt;/span&gt; tls_connect(..., &lt;span style=&quot;color:#0000aa&quot;&gt;int&lt;/span&gt; flags) {&#xa;    &lt;span style=&quot;color:#0000aa&quot;&gt;int&lt;/span&gt; verify = (&lt;b&gt;flags&lt;/b&gt; &amp;gt;&amp;gt; 4) &amp;amp; 1;&#xa;    &lt;span style=&quot;color:#0000aa&quot;&gt;if&lt;/span&gt; (verify)&#xa;        SSL_set_verify(ctx, SSL_VERIFY_PEER, NULL);&#xa;    &lt;span style=&quot;color:#0000aa&quot;&gt;else&lt;/span&gt;&#xa;        SSL_set_verify(ctx, SSL_VERIFY_NONE, NULL);&#xa;    &lt;span style=&quot;color:#888888&quot;&gt;// BUG: no hostname verification (e.g., X509_check_host)&lt;/span&gt;&#xa;}&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="50" y="85" width="340" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="flags-q" value="flags = ?" style="text;html=1;strokeColor=none;fillColor=#ffffcc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1;fontFamily=Consolas,Monaco,monospace;" parent="1" vertex="1">
                    <mxGeometry x="410" y="120" width="70" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="note-hostname" value="Missing hostname verification&#xa;(completeness/spec)" style="text;html=1;strokeColor=#999999;fillColor=#ffe6e6;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=2;fontFamily=Helvetica;dashed=1;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="400" y="150" width="140" height="40" as="geometry"/>
