                <mxCell id="left-label" value="(a) (C2) Configuration Provenance Across Boundaries" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1">
