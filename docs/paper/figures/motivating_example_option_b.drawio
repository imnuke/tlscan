                <mxCell id="config-frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="320" y="390" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="config-title" value="/etc/client_b.conf" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="330" y="395" width="160" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="config-content" value="&lt;pre style=&quot;margin:0;padding:8px;font-family:Consolas,Monaco,monospace;font-size:10px;line-height:1.4;text-align:left;&quot;&gt;certverify = &lt;span style=&quot;color:#cc0000&quot;&gt;(missing)&lt;/span&gt;  &lt;span style=&quot;color:#888888&quot;&gt;# default = 0&lt;/span&gt;&#xa;# → flags bit 4 = 0&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="330" y="420" width="180" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="left-evidence" value="Evidence chain (simplified):&#xa;parse_conf() → g_certverify → flags(bit4) → tls_connect() → SSL_set_verify(...)" style="text;html=1;strokeColor=#999999;fillColor=#f0f0f0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontFamily=Helvetica;dashed=1;strokeWidth=1;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
