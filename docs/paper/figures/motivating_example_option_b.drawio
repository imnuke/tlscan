                <mxCell id="upsc-title" value="/usr/bin/client_a" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="50" y="245" width="120" height="20" as="geometry"/>
