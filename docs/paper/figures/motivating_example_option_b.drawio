                <mxCell id="right-label" value="(b) (C1) Semantics Beyond API Templates" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="820" y="20" width="320" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="msmtp-frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="600" y="55" width="520" height="340" as="geometry"/>
                </mxCell>
                <mxCell id="msmtp-title" value="/usr/bin/client_c (custom TLS)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="610" y="60" width="80" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="msmtp-connect" value="&lt;pre style=&quot;margin:0;padding:8px;font-family:Consolas,Monaco,monospace;font-size:10px;line-height:1.4;text-align:left;&quot;&gt;&lt;span style=&quot;color:#0000aa&quot;&gt;int&lt;/span&gt; tls_connect_custom(tls_t *t, ...) {&#xa;    SSL_connect(t-&amp;gt;ssl);&#xa;    &lt;span style=&quot;color:#0000aa&quot;&gt;if&lt;/span&gt; (!t-&amp;gt;&lt;b&gt;no_certcheck&lt;/b&gt;) {&#xa;        &lt;span style=&quot;color:#0000aa&quot;&gt;return&lt;/span&gt; &lt;b&gt;cert_verify_custom&lt;/b&gt;(t);&#xa;    }&#xa;    &lt;span style=&quot;color:#0000aa&quot;&gt;return&lt;/span&gt; 0;&#xa;}&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="610" y="85" width="290" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="msmtp-verify" value="&lt;pre style=&quot;margin:0;padding:8px;font-family:Consolas,Monaco,monospace;font-size:10px;line-height:1.35;text-align:left;&quot;&gt;&lt;span style=&quot;color:#0000aa&quot;&gt;int&lt;/span&gt; cert_verify_custom(tls_t *t) {&#xa;    &lt;span style=&quot;color:#0000aa&quot;&gt;long&lt;/span&gt; r = &lt;b&gt;SSL_get_verify_result&lt;/b&gt;(t-&amp;gt;ssl);&#xa;    &lt;span style=&quot;color:#0000aa&quot;&gt;if&lt;/span&gt; (r != X509_V_OK &amp;amp;&amp;amp; r != X509_V_ERR_UNABLE_TO_GET_ISSUER_CERT_LOCALLY)&#xa;        &lt;span style=&quot;color:#0000aa&quot;&gt;return&lt;/span&gt; -1;   &lt;span style=&quot;color:#cc0000&quot;&gt;// BUG: ignores some chain errors&lt;/span&gt;&#xa;&#xa;    san = X509_get_ext_d2i(cert, NID_subject_alt_name, ...);&#xa;    &lt;span style=&quot;color:#0000aa&quot;&gt;for&lt;/span&gt; (...) {&#xa;        &lt;span style=&quot;color:#0000aa&quot;&gt;if&lt;/span&gt; (&lt;b&gt;sub_418D5E&lt;/b&gt;(t-&amp;gt;host, san_entry))&#xa;            &lt;span style=&quot;color:#0000aa&quot;&gt;return&lt;/span&gt; 0;&#xa;    }&#xa;    &lt;span style=&quot;color:#0000aa&quot;&gt;return&lt;/span&gt; -1;&#xa;}&#xa;&#xa;&lt;span style=&quot;color:#0000aa&quot;&gt;int&lt;/span&gt; sub_418D5E(host, pat) {&#xa;    &lt;span style=&quot;color:#0000aa&quot;&gt;if&lt;/span&gt; (starts_with(pat, &quot;*.&quot;))&#xa;        &lt;span style=&quot;color:#0000aa&quot;&gt;return&lt;/span&gt; ends_with(host, pat+2); &lt;span style=&quot;color:#cc0000&quot;&gt;// BUG: no label boundary check&lt;/span&gt;&#xa;    &lt;span style=&quot;color:#0000aa&quot;&gt;return&lt;/span&gt; strcasecmp(host, pat) == 0;&#xa;}&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="610" y="215" width="340" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="msmtp-config-frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="970" y="85" width="140" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="msmtp-config-title" value="/etc/client_c.conf" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="980" y="90" width="80" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="msmtp-config-content" value="&lt;pre style=&quot;margin:0;padding:8px;font-family:Consolas,Monaco,monospace;font-size:10px;line-height:1.4;text-align:left;&quot;&gt;tls = on&#xa;tls_certcheck = on&#xa;hostname = &quot;example.com&quot;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="980" y="115" width="120" height="40" as="geometry"/>
                </mxCell>
